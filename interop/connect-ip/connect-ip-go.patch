+// answerAddressRequests answers each of the client's address requests until the connection
+// closes, by the rule of h3wire's ip-proxy: a request gets addr if it asks for exactly that
+// address or for any address of its family (all-zero), every other one a rejection. addr
+// is in the answer either way, since an assignment replaces the previous one.
+func answerAddressRequests(conn *connectip.Conn, addr netip.Addr) {
+	host := netip.PrefixFrom(addr, addr.BitLen())
+	for {
+		req, err := conn.ReceiveAddressRequest(context.Background())
+		if err != nil {
+			return
+		}
+		assignments := make([]netip.Prefix, len(req.Prefixes))
+		var additional []netip.Prefix
+		assigned := false
+		for i, p := range req.Prefixes {
+			if p == host || (p.Addr().IsUnspecified() && p.Addr().Is4() == addr.Is4()) {
+				assignments[i] = host
+				assigned = true
+			}
+		}
+		if !assigned {
+			additional = []netip.Prefix{host}
+		}
+		if err := req.Respond(assignments, additional); err != nil {
+			log.Printf("failed to answer address request: %v", err)
+			return
+		}
+		log.Printf("answered address request %v with %v (additional %v)", req.Prefixes, assignments, additional)
+	}
+}

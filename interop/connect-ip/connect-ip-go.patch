+// runAddressRequest requests the comma-separated prefixes in v and requires the next
+// address assignment to assign the first (with the requested prefix) and reject the second.
+func runAddressRequest(ipconn *connectip.Conn, v string) error {
+	var prefixes []netip.Prefix
+	for _, s := range strings.Split(v, ",") {
+		p, err := netip.ParsePrefix(s)
+		if err != nil {
+			return fmt.Errorf("REQUEST_ADDRS: %w", err)
+		}
+		prefixes = append(prefixes, p)
+	}
+	if len(prefixes) < 2 {
+		return errors.New("REQUEST_ADDRS: at least two prefixes")
+	}
+	ids, err := ipconn.RequestAddresses(prefixes)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	assigned, err := ipconn.ReceiveAddressAssignment(ctx)
+	if err != nil {
+		return fmt.Errorf("no answer: %w", err)
+	}
+	find := func(id connectip.AddressRequestID) *connectip.AssignedAddress {
+		for i := range assigned {
+			if assigned[i].RequestID == id {
+				return &assigned[i]
+			}
+		}
+		return nil
+	}
+	a, b := find(ids[0]), find(ids[1])
+	if a == nil || b == nil {
+		return fmt.Errorf("assignment %v does not answer requests %d and %d", assigned, ids[0], ids[1])
+	}
+	if a.Rejected() || a.IPPrefix != prefixes[0] || !b.Rejected() {
+		return fmt.Errorf("unexpected answer %v, %v", *a, *b)
+	}
+	fmt.Printf("address-request: ok ids=%d,%d\n", ids[0], ids[1])
+	return nil
+}
